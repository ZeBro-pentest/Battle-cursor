        {
          "name": "GET Inventory Before",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "{",
                  "    const inventory = pm.response.json();",
                  "    const ownedCursorIds = (inventory.cursors || []).map(c => c.id);",
                  "    const ownedCanvasIds = (inventory.canvases || []).map(c => c.id);",
                  "",
                  "    const marketCursors = JSON.parse(pm.environment.get(\"market_cursors\") || \"[]\");",
                  "    const marketCanvases = JSON.parse(pm.environment.get(\"market_canvases\") || \"[]\");",
                  "",
                  "    const availableCursor = marketCursors.find(c => !ownedCursorIds.includes(c.id));",
                  "    const availableCanvas = marketCanvases.find(c => !ownedCanvasIds.includes(c.id));",
                  "",
                  "    if (availableCursor) {",
                  "        pm.environment.set(\"test_cursor_id\", availableCursor.id);",
                  "    } else {",
                  "        pm.environment.set(\"test_cursor_id\", null);",
                  "    }",
                  "",
                  "    if (availableCanvas) {",
                  "        pm.environment.set(\"test_canvas_id\", availableCanvas.id);",
                  "    } else {",
                  "        pm.environment.set(\"test_canvas_id\", null);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ACCESS_TOKEN}}",
                  "type": "string"
